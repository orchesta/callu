# ╔══════════════════════════════════════════════════════════════╗
# ║  Callu — environment for the full Docker stack                 ║
# ║  (db, redis, rabbitmq, api, worker, web)                       ║
# ╠══════════════════════════════════════════════════════════════╣
# ║  Copy this file to .env and fill in every value left empty      ║
# ║  below before running `docker compose up -d`. Compose refuses   ║
# ║  to start while any of them is unset. NEVER commit your .env.   ║
# ╚══════════════════════════════════════════════════════════════╝

# ─── PostgreSQL (callu-db service) ───────────────────────────
POSTGRES_DB=calludb
POSTGRES_USER=callu
# Required. Use a long random password.
POSTGRES_PASSWORD=

# ─── API / Worker → database (internal network: service name) ─
DB_HOST=callu-db
DB_PORT=5432

# ─── RabbitMQ (callu-rabbitmq) — the message broker ───────────
RABBITMQ_USER=callu
# Required. Use a long random password.
RABBITMQ_PASS=
# RABBITMQ_HOST=callu-rabbitmq
# Management UI port. Bound to 127.0.0.1 only, so it is reachable from this machine
# and not from the LAN.
RABBITMQ_MGMT_PORT=15672

# ─── Redis (callu-redis) — HybridCache L2 + SignalR backplane + DataProtection key ring ─
# Required. Redis stores the DataProtection key ring, which decrypts the stored SMTP and
# SIP passwords, so it must not be reachable without authentication.
#
# NO COMMAS OR SPACES. A Redis connection string separates its options with ',' and there is no
# way to escape one, so a comma in the password silently splits it — part of the password ends up
# being read as a second server address. The API logs a warning at startup if it detects this
# (it sees more endpoints than you configured). Use REDIS_CONNECTION_STRING below if you are
# stuck with such a password.
REDIS_PASSWORD=
#
# Compose builds the Redis connection string from REDIS_HOST / REDIS_PORT / REDIS_PASSWORD,
# so the password is always applied. Point them at an external Redis if you have one.
REDIS_HOST=callu-redis
REDIS_PORT=6379
# Optional extra StackExchange.Redis options, appended verbatim (must start with a comma), e.g.
#   REDIS_EXTRA_OPTIONS=,ssl=True,abortConnect=false
# REDIS_EXTRA_OPTIONS=
#
# ESCAPE HATCH — overrides all four variables above for the API and Worker. Use it for an
# EXTERNAL Redis that the parts cannot express: no password at all, an ACL username, or a
# password containing a comma. Note REDIS_PASSWORD is still required even then (the bundled
# callu-redis service demands one); just set it to any placeholder if you are not starting that
# service. Point BOTH hosts at the SAME Redis — they share one key ring.
#   REDIS_CONNECTION_STRING=my-redis.internal:6379,user=callu,password=…,ssl=True
# REDIS_CONNECTION_STRING=
#
# The bundled Redis persists with RDB snapshots into the callu_redis_data volume. Do not add
# `--appendonly yes` to the compose command: on a volume that only has dump.rdb, Redis would
# start from an empty dataset and the key ring would be gone. Enable AOF on a running instance
# instead (`CONFIG SET appendonly yes` + `CONFIG REWRITE`).

# ─── JWT ─────────────────────────────────────────────────────
# Required. Must be at least 32 bytes and must not be an example/placeholder value —
# the API refuses to start otherwise. Generate one with:
#   openssl rand -base64 48
JWT_SECRET_KEY=
JWT_ISSUER=CalluApp
JWT_AUDIENCE=CalluApp
# Access tokens are short-lived; the SPA silently renews them with the 7-day refresh
# cookie, so raising this only widens the window for a leaked token.
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# ─── Web (nginx) ─────────────────────────────────────────────
WEB_PORT=3000
# Set these to your public URL in production (e.g. https://callu.example.com).
CORS_ORIGINS=http://localhost:3000
CALLU_PUBLIC_URL=http://localhost:3000

# HSTS. Browsers honour this only over HTTPS, so it does nothing on a plain-HTTP install.
# The default is short on purpose: while it is in force a browser refuses to reach the site
# over HTTP, so an install whose certificate later breaks is unreachable for that long.
# Raise it once TLS has been stable for a while; 0 removes the header. `preload` bakes the
# domain into browsers and is effectively permanent — only turn it on for a domain you own.
HSTS_MAX_AGE_SECONDS=300
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=Warning
# Container stdout (`docker logs`) is capped so a chatty service cannot fill the
# host disk. The API and Worker also write rolling files to the callu_logs
# volume — that is the copy that survives a container recreate.
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# ─── Notifications ───────────────────────────────────────────
# Minimum spacing (seconds) between voice calls to the SAME user coming from
# DIFFERENT incidents — protects the on-call from an alert-flood dialing them
# 10 times in a row. Deferred calls are placed one by one afterwards; re-dials
# for a single unacknowledged incident are never throttled. 0 = off (default).
VOICE_CALL_COOLDOWN_SECONDS=0

# The generic HTTP-SMS provider only calls gateways that resolve to a public IP — private,
# loopback and link-local addresses are refused (SSRF guard, and it also blocks cloud
# metadata endpoints). Set this to true if your SMS gateway really does live on the LAN;
# leave it false otherwise. With it false, sends to a private address fail and are logged.
ALLOW_PRIVATE_SMS_ENDPOINT=false

# ─── Voximplant (temporary upgrade switch) ───────────────────
# Voximplant call scenarios now bind each callback to the incident it was placed for. Callbacks
# without that binding (calls that were already ringing when you upgraded, or scenarios that have
# not been re-provisioned yet) are rejected.
#
# KEEP THIS false. While it is true, an unbound callback is honoured — so a scenario key that
# leaks can acknowledge ANY incident, not just the one it was issued for. Turn it on only to ride
# out an upgrade with calls in flight, then re-provision under Settings → Communications →
# Voximplant → Provision (that page tells you when your scenarios are stale) and set it back
# to false.
VOXIMPLANT_ALLOW_LEGACY_UNBOUND_CALLBACKS=false

# ─── Quartz (Worker) ─────────────────────────────────────────
QUARTZ_USE_PERSISTENT_STORE=false

# ─── Retention (Worker, daily 04:00 UTC) ─────────────────────
# 0 keeps rows forever, which is the default for every table below. Each of them
# grows with incident volume, so on a small VPS set the windows you can live with.
# Deletes are chunked, and the job does nothing at all while all six are 0.
RETENTION_NOTIFICATION_DAYS=0
RETENTION_AUDIT_LOG_DAYS=0
RETENTION_WEBHOOK_CAPTURE_DAYS=0
RETENTION_CALL_LOG_DAYS=0
RETENTION_STATUS_PAGE_VIEW_DAYS=0
RETENTION_INCIDENT_TIMELINE_EVENT_DAYS=0

# ─── Audit trail stream (API + Worker) ───────────────────────
# Every audit entry is also written as one compact JSON object per line, on the
# callu_logs volume, so an existing collector (Filebeat, Vector, Fluent Bit) can
# ship it to a SIEM with no code. The AuditLogs table stays the record of what
# happened; this file is a copy, and it does not carry the old/new values — read
# those from the audit log export.
#
# Set the path to an empty string to turn the stream off. Files roll daily and at
# 50 MB; the retained count below is what a self-hosted install keeps on disk while
# the collector catches up.
AUDIT_TRAIL_STREAM_PATH=/app/logs/audit-.jsonl
AUDIT_TRAIL_STREAM_RETAINED_FILES=90

# ─── Audit syslog forwarding (API + Worker) ──────────────────
# Off by default. Set a host and every audit entry is also sent to a syslog
# collector as an RFC 5424 frame carrying a CEF message — the format ArcSight,
# Splunk and QRadar read without a custom parser. Delivery is TCP with octet
# counting (RFC 6587); TLS is the default and has to be turned off explicitly.
#
# This is a copy, not the record. If the collector is unreachable, entries queue
# up to AUDIT_SYSLOG_QUEUE_CAPACITY and then the oldest are dropped and counted
# in the log — the AuditLogs table and the audit-.jsonl stream still have all of
# them, so nothing is lost, but the collector's view will have a hole.
#
# ACCEPT_ANY_CERT disables certificate validation. It is for a collector with an
# internal CA this host cannot chain, and it means anything on the path can read
# and forge the trail — the Worker logs a warning at startup when it is on.
#
# FACILITY 13 is syslog's "log audit". Change it only if your collector routes on
# a different one.
AUDIT_SYSLOG_HOST=
AUDIT_SYSLOG_PORT=6514
AUDIT_SYSLOG_USE_TLS=true
AUDIT_SYSLOG_ACCEPT_ANY_CERT=false
AUDIT_SYSLOG_FACILITY=13
AUDIT_SYSLOG_QUEUE_CAPACITY=10000

# ─── Audit archive (Worker, daily 03:30 UTC) ─────────────────
# Off by default. Set a path and the Worker writes each closed day of the audit
# trail to <path>/audit-YYYY-MM-DD.jsonl.gz, plus a manifest.json carrying each
# file's SHA-256, row count and chain sequence range. The archive is meant to
# outlive the database, so point it at a volume you back up — or a mount backed
# by object storage with a retention lock, if that is what your review asks for.
#
# The rule that makes this worth having: while archiving is ON, retention will
# NOT delete an audit entry that has not reached the archive yet. If archiving
# stalls, entries accumulate instead of disappearing. Turning archiving on
# without watching the Worker log is how a disk fills up quietly.
#
# A day is archived once it is AFTER_DAYS old, and only if every entry in it is
# already in the hash chain — an unchained entry could not be verified from the
# archive later.
AUDIT_ARCHIVE_PATH=
AUDIT_ARCHIVE_AFTER_DAYS=2
AUDIT_ARCHIVE_MAX_DAYS_PER_RUN=31

# ─── OpenTelemetry / Jaeger (default: on, internal Docker network) ─
# OTLP :4317 is not published to the host — only the api/worker containers
# reach callu-jaeger:4317. Set OPEN_TELEMETRY_ENABLED=false to turn telemetry
# off entirely; nothing new then reaches Jaeger, so the in-app Diagnostics page
# empties out as the traces already stored fall past their retention window.
OPEN_TELEMETRY_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://callu-jaeger:4317
#
# Read side: the API queries this to render the Diagnostics page, so operators
# read traces with their normal Callu login. Jaeger's own UI has NO authentication,
# which is why its port stays on 127.0.0.1 and is not the intended way in. Unset
# this and the Diagnostics page stays reachable but reports tracing unavailable.
JAEGER_QUERY_URL=http://callu-jaeger:16686
# Bound to this machine only (not reachable from the LAN). You do not need it
# open to read traces — use the Diagnostics page.
JAEGER_UI_PORT=16686
# Traces are stored on disk (badger) and survive a restart. Disk growth is bounded
# by this retention window, not by a span count. Not an audit trail: for the durable
# record of an incident use the incident timeline and audit log.
JAEGER_TRACE_TTL=72h

# ─── Container memory limits ─────────────────────────────────
# Raise these if a container gets OOM-killed under your load.
API_MEMORY_LIMIT=1g
WORKER_MEMORY_LIMIT=768m
WEB_MEMORY_LIMIT=256m
JAEGER_MEMORY_LIMIT=512m

# ─── Self-hosted voice paging (optional) ─────────────────────
# Only read when you start the stack with `docker compose --profile voice up -d`.
#
# The container refuses to start without these three. There is no safe default for
# "whose numbers may I dial", so ALLOWED_PREFIXES has none.
#   openssl rand -hex 24   ->  VOICE_API_TOKEN
#   openssl rand -hex 16   ->  VOICE_ARI_PASSWORD
VOICE_API_TOKEN=
VOICE_ARI_PASSWORD=
VOICE_ALLOWED_PREFIXES=

# Bridged Docker is NAT. Without this the call connects and nobody hears anything:
# set it to the address your carrier reaches this host on.
EXTERNAL_MEDIA_ADDRESS=
EXTERNAL_SIGNALING_ADDRESS=

# Your carrier is NOT set here. It goes in Settings -> Communications: add a SIP trunk, pick
# it on the callu-voice provider, and Callu sends it to the container. The container starts
# with no carrier and keeps none across a restart — Callu checks every few minutes and sends
# it again when it is missing, so a recreate or an image bump heals itself.

# Published on the host. The RTP range must match exactly what the container advertises.
SIP_PORT=5060
RTP_START=10000
RTP_END=10099

VOICE_MEM_LIMIT=3g

# For callu-voice service to be started
COMPOSE_PROFILES=voice