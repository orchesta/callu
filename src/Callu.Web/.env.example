# Callu Web - Environment Variables
# Copy this file to .env.local for local development.
# Every variable below is optional and shows its built-in default; the Docker
# image is built without any of them, in which case the SPA calls its own origin.

# Backend API base URL (no trailing slash, no /api suffix).
# Left unset the SPA calls window.location.origin, which is right behind nginx
# but not in local dev, where the API listens on another port.
VITE_API_URL=http://localhost:5095

# Auth token localStorage key
VITE_AUTH_TOKEN_KEY=calluapp_auth_token

# API request timeout in milliseconds
VITE_API_TIMEOUT=30000
